      "targetField": "title"
    },
    "pdf1": {
      "allowedTypes": [
        "files"
      ],
      "type": "media",
      "multiple": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "duration": {
      "pluginOptions": {
        "i18n": {
          "localized": true
