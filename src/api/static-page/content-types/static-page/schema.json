{
  "kind": "collectionType",
  "collectionName": "static_pages",
  "info": {
    "singularName": "static-page",
    "pluralName": "static-pages",
    "displayName": "Static Page",
    "description": "Custom static pages linkable from menu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "content": {
      "type": "customField",
      "options": { "output": "HTML", "preset": "rich" },
      "customField": "plugin::ckeditor.CKEditor",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "showInMenu": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
